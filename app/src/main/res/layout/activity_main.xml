<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="0dp">

    <TextView
        android:id="@+id/restaurantNameTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:text="HABESHAN FOOD"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="italic" />


    <ImageView
        android:id="@+id/logoIV"
        android:layout_width="311dp"
        android:layout_height="134dp"
        android:padding="0dp"
        android:src="@drawable/hfl" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:text="Eritrean and Ethiopian Food"
        android:textSize="24sp" />



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Hours: 10 AM - 9 PM"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Phone: 410-567-1234"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/nameET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What is your name?"
        android:textSize="20dp" />

    <Button
        android:id="@+id/welcomeBTN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WELCOME ME"
        android:textColor="@color/Yellow"
        android:textSize="22dp" />

    <TextView
        android:id="@+id/welcomeTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="20sp" />


    <TextView
        android:id="@+id/addressTV"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:gravity="center"
        android:text="Addis Ethiopian Restaurant 316 Park Ave, Baltimore, MD 21201"
        android:textColor="@color/blue"
        android:textSize="25dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/menuBTN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VIEW MENU"
        android:textColor="@color/orange"
        android:textSize="22sp" />

</LinearLayout>